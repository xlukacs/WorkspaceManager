# Directory that holds the Workspace Manager store (workspace-manager.json).
# On Linux the desktop app uses ~/.config/Workspace Manager.
WORKSPACE_MANAGER_CONFIG_DIR=/home/YOU/.config/Workspace Manager

# Host directory that contains your project checkouts. It is bind-mounted at the
# same path inside the container so store paths keep working.
WORKSPACES_HOST_PATH=/home/YOU/src

# Optional bearer token. If set, agents must send Authorization: Bearer <token>.
MCP_TOKEN=

# Host interface to publish on. Keep 127.0.0.1 unless MCP_TOKEN is set.
MCP_BIND=127.0.0.1
MCP_PORT=3847

# Comma-separated browser origins allowed to call the server. Agents need none.
MCP_ALLOWED_ORIGINS=

UID=1000
GID=1000
VERSION=0.1.0
